menu "Rail monitor"

config RAIL_WIFI_SSID
    string "WiFi SSID"
    default "TP_Link_0624"
    help
        WPA2-Personal SSID. Leave empty to skip WiFi bring-up; the UI
        shows a "configure WiFi" message.

config RAIL_WIFI_PASSWORD
    string "WiFi password"
    default "peal2024"
    help
        WPA2-Personal passphrase. Stored in the local sdkconfig only.

config RAIL_SERVER_URL
    string "Rail server base URL"
    default "http://192.168.1.16:17052"
    help
        Base URL of the LinearMotorController FastAPI server. Include the
        scheme and port. A trailing slash is optional.

config RAIL_POLL_INTERVAL_S
    int "Status poll interval (seconds)"
    default 2
    range 1 60
    help
        How often to GET /status from the server.

endmenu
